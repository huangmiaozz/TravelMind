APP_NAME=TravelMind API
APP_VERSION=0.1.0
# 将用户名、密码和端口替换为你安装 PostgreSQL 时设置的值。
DATABASE_URL=postgresql+psycopg://travelmind_user:CHANGE_ME@localhost:5432/travelmind

# 高德地图 Web 服务 API Key（https://console.amap.com/）
# 申请时「服务平台」必须选 Web服务，不要选 Web端(JS API) —— 后端调用的是 REST 接口。
# 未配置时，依赖它的能力会被显式跳过，不会静默回退到估算值。
#
# ⚠️ 本文件是模板，会随仓库公开。真实 Key 请写进同目录的 .env，
#    该文件已被 .gitignore 排除，不会被提交。
AMAP_API_KEY=
AMAP_MODE=mock
